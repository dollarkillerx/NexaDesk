    "Screen capture or video encoding failed on the host. On a Mac, NexaDesk needs the Screen Recording permission.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作される側で画面のキャプチャまたはビデオのエンコードに失敗しました。Mac の場合、NexaDesk に「画面収録」の権限が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被控端的屏幕采集或视频编码出错。如果对方是 Mac，需要授予 NexaDesk “屏幕录制”权限。"
          }
