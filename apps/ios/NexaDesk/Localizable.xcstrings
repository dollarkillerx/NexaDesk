            "state": "translated",
            "value": "信令服务器"
          }
        }
      }
    },
    "Something unexpected went wrong. Try again; if it keeps happening, restart NexaDesk.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予期しないエラーが発生しました。もう一度お試しください。繰り返し発生する場合は、NexaDesk を再起動してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发生了意外错误。请重试；如果反复出现，请重启 NexaDesk。"
          }
        }
      }
    },
    "Source code on GitHub": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub のソースコード"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 上的源代码"
          }
        }
      }
    },
    "Spotlight": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight"
          }
        },
        "zh-Hans": {
