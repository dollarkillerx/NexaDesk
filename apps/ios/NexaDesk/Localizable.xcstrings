          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换应用"
          }
        }
      }
    },
    "Task Manager": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクマネージャー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务管理器"
          }
        }
      }
    },
    "Test": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テスト"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试"
          }
        }
      }
    },
    "Testing…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テスト中…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试中…"
          }
        }
      }
    },
    "That is not a signaling server address. Use signal.example.com, signal.example.com:8443 or wss://signal.example.com:8443.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シグナリングサーバーのアドレスではありません。signal.example.com、signal.example.com:8443、または wss://signal.example.com:8443 の形式で入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是信令服务器地址。请填写 signal.example.com、signal.example.com:8443 或 wss://signal.example.com:8443。"
          }
        }
      }
    },
    "The address or one-time code isn't in the right format.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレスまたはワンタイムコードの形式が正しくありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址或一次性码的格式不对。"
          }
        }
      }
    },
    "The computer can't share its screen": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手のコンピュータが画面を共有できません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方无法共享屏幕"
          }
        }
      }
    },
    "The computer didn't respond in time. Make sure the address is right and the computer is online, then try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手のコンピュータが時間内に応答しませんでした。アドレスが正しく、相手がオンラインであることを確認してから、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方没有及时响应。请确认地址正确、对方在线，然后重试。"
          }
        }
      }
    },
    "The computer ended the session": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手のコンピュータがセッションを終了しました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方结束了会话"
          }
        }
      }
    },
    "The computer has no saved pairing with this device. Enter the one-time code shown on its screen.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手のコンピュータにこのデバイスとのペアリングが保存されていません。相手の画面に表示されているワンタイムコードを入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方没有保存与本机的配对。请输入对方屏幕上显示的一次性码。"
          }
        }
      }
    },
    "The computer is offline": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手がオフラインです"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方不在线"
          }
        }
      }
    },
    "The computer's identity doesn't match the saved pairing": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手のコンピュータの識別情報が保存済みのペアリングと一致しません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方的身份与已保存的配对不一致"
          }
        }
      }
    },
    "The connection dropped unexpectedly.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続が予期せず切断されました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接意外中断。"
          }
        }
      }
    },
    "The connection was not accepted": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手が接続を承認しませんでした"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方没有同意连接"
          }
        }
      }
    },
    "The host disconnected or stopped allowing control.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作される側が接続を切断したか、操作の許可を停止しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被控端断开了连接，或停止了允许控制。"
          }
        }
      }
    },
    "The key could not be saved in the Keychain (error %lld).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーをキーチェーンに保存できませんでした（エラー %lld）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "口令没能存进钥匙串（错误 %lld）。"
          }
        }
      }
    },
    "The person at the computer declined, didn't respond in time, or nobody is there to accept.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手がリクエストを拒否したか、時間内に応答しなかったか、相手のコンピュータの前に承認できる人がいません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方拒绝了请求、没有在限定时间内回应，或者对方电脑前当前没有可以确认的人。"
          }
        }
      }
    },
    "The server asks for a key and did not accept this one. Check it with the server's owner; it is not the computer's one-time code or password.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーはアクセスキーを求めていますが、このキーは受け付けられませんでした。サーバーの管理者に確認してください。コンピュータのワンタイムコードやパスワードとは別のものです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器要求访问口令，但没有接受这一个。请向服务器的管理者确认。它不是电脑上的一次性码或密码。"
          }
        }
      }
    },
    "The server's key (required)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーのキー（必須）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器要求的口令（必填）"
          }
        }
      }
    },
    "The two devices' hardware codecs don't match, so no video stream can be set up.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2台のデバイスのハードウェアコーデックが一致しないため、ビデオストリームを確立できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两台设备的硬件编解码能力不匹配，无法建立视频流。"
          }
        }
      }
    },
    "This device ID isn't connected to the signaling server right now. Make sure the computer has “Allow remote control” turned on and both sides use the same signaling server.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイス ID は現在シグナリングサーバーに接続されていません。相手が「操作を許可」をオンにしていること、および双方が同じシグナリングサーバーを使っていることを確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个设备 ID 现在没有连到信令服务器。请确认对方已开启“允许别人控制本机”，并且两边设置的是同一台信令服务器。"
          }
        }
      }
    },
    "To prevent guessing, the computer is refusing new attempts for now. Wait a minute and try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "推測を防ぐため、相手のコンピュータは新しい試行を一時的に拒否しています。1 分ほど待ってから、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为防止猜码，对方暂时拒绝了新的尝试。请稍等一分钟再试。"
          }
        }
      }
    },
    "Too many attempts": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "試行回数が多すぎます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尝试次数过多"
          }
        }
      }
    },
    "Touch mode": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タッチモード"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触摸模式"
          }
        }
      }
    },
    "Touch: tap to click there, drag to drag, touch and hold for a right click. Two fingers: drag to scroll, pinch to zoom.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タッチ：タップした場所をクリック、ドラッグでドラッグ、長押しで右クリック。2本指：ドラッグでスクロール、ピンチでズーム。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触摸：轻点即在该处单击，拖动即拖拽，长按为右键。双指：拖动滚动，捏合缩放。"
          }
        }
      }
    },
    "Trackpad mode": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トラックパッドモード"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触控板模式"
          }
        }
      }
    },
    "Trackpad: drag to move the pointer, tap to click, touch and hold to drag. Two fingers: tap for a right click, drag to scroll, pinch to zoom.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トラックパッド：ドラッグでポインタを移動、タップでクリック、長押ししてから動かすとドラッグ。2本指：タップで右クリック、ドラッグでスクロール、ピンチでズーム。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触控板：拖动移动指针，轻点单击，按住后拖动可拖拽。双指：轻点右键，拖动滚动，捏合缩放。"
          }
        }
      }
    },
    "Trust and connect": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "信頼して接続"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "信任并连接"
          }
        }
      }
    },
    "Trust this signaling server?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このシグナリングサーバーを信頼しますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "信任这台信令服务器吗？"
          }
        }
      }
    },
    "Undo": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り消す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销"
          }
        }
      }
    },
    "Unfavorite": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りから外す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消收藏"
          }
        }
      }
    },
    "Update NexaDesk on both sides to the same version.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方の NexaDesk を同じバージョンにアップデートしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请把两边的 NexaDesk 更新到同一版本。"
          }
        }
      }
    },
    "Use the form wss://server[:port], for example wss://signal.example.com. A signaling server always needs its key: enter the one its owner gave you. A server with its own certificate is trusted on first use, after you compare its fingerprint.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "wss://サーバー[:ポート] の形式で入力してください（例：wss://signal.example.com）。シグナリングサーバーには必ずキーが必要です。サーバーの管理者から受け取ったキーを入力してください。独自の証明書を使うサーバーは、初回にフィンガープリントを確認すれば信頼できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "格式应为 wss://服务器[:端口]，例如 wss://signal.example.com。信令服务器一定要口令，请填写服务器管理者给你的口令。使用自签证书的服务器，第一次连接时核对指纹后即可信任。"
          }
        }
      }
    },
    "Version %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本 %@"
          }
        }
      }
    },
    "Video: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビデオ：%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频：%@"
          }
        }
      }
    },
    "Website": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Web サイト"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "官网"
          }
        }
      }
    },
    "Wrong key for the signaling server": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シグナリングサーバーのアクセスキーが違います"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "信令服务器的访问口令不对"
          }
        }
      }
    },
    "You can connect without a server: directly on the same local network, and across networks with Tailscale on both devices. A signaling server is needed only to connect by 9-digit device ID.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーがなくても接続できます。同じローカルネットワークなら直接、別のネットワークなら両方で Tailscale を使うのがおすすめです。シグナリングサーバーが必要なのは、9 桁のデバイス ID で接続したい場合だけです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不用服务器也能连接：同一局域网直接连；不在同一网络时，推荐两边都用 Tailscale。只有想按 9 位设备 ID 连接时，才需要信令服务器。"
          }
        }
      }
    },
    "You ended this session.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセッションを終了しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你结束了这次会话。"
          }
        }
      }
    }
  }
}