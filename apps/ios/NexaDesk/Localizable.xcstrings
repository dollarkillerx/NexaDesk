          "stringUnit": {
            "state": "translated",
            "value": "スタート"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始菜单"
          }
        }
      }
    },
    "Swipe right to add one to Favorites, left to remove it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
