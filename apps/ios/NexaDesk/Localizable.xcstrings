      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NexaDesk のシグナリングサーバーではありません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不是 NexaDesk 信令服务器"
          }
        }
      }
    },
    "Not paired with this device": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスとはペアリングされていません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未与这台设备配对"
          }
        }
      }
    },
    "Not used": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未使用"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未使用"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        }
      }
    },
    "On the same network (or Tailscale), an IP address is enough; port %@ is assumed. From anywhere else, use the 9-digit device ID with a signaling server.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じネットワーク（または Tailscale）なら IP アドレスだけで接続できます（ポートは %@ を想定）。それ以外の場所からは、9 桁のデバイス ID とシグナリングサーバーを使います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在同一网络（或 Tailscale）中，填 IP 地址即可，默认端口为 %@。在其他地方，请用 9 位设备 ID 配合信令服务器连接。"
          }
        }
      }
    },
    "On this network": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このネットワーク上のコンピュータ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本网络中的电脑"
          }
        }
