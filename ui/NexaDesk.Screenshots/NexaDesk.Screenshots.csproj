<Project Sdk="Microsoft.NET.Sdk">
  <!-- Renders the README screenshots: the real views and view-models, headless, at 2x,
       with made-up devices and addresses so no real machine shows up in them.
         scripts/screenshots.sh, or dotnet run on this project with the output directory -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.6" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.6" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../NexaDesk.App/NexaDesk.App.csproj" />
  </ItemGroup>
</Project>
