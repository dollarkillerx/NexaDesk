<?xml version="1.0" encoding="utf-8"?>
<!-- NexaDesk.exe's manifest on Windows (ignored elsewhere). Without the supportedOS entry
     Windows runs the app as if it were written for Windows 7, and layered child windows,
     which Avalonia's NativeControlHost uses to hold the session's video view, cannot be
     made: opening a session window then crashed ("Unable to create child window for
     native control host"). -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="NexaDesk.app"/>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
