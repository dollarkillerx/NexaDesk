<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NexaDesk.ViewModels"
        xmlns:l="using:NexaDesk.Localization"
        x:Class="NexaDesk.Views.PermissionGuideWindow"
        x:DataType="vm:PermissionGuideViewModel"
        Title="{l:T Permissions.WindowTitle}"
        Width="560" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CardBrush}">
  <Grid RowDefinitions="Auto,Auto">
  <StackPanel Margin="16,16,16,24" Spacing="12">
    <TextBlock Classes="h1" Text="{Binding Title}" />
    <TextBlock TextWrapping="Wrap" Text="{Binding Intro}" />

    <Border Classes="subtle" IsVisible="{Binding ShowScreenRecording}">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <TextBlock FontWeight="SemiBold" Text="{Binding ScreenRecordingUse}" TextWrapping="Wrap" />
        <TextBlock Grid.Column="1" Name="ScreenRecordingState" Text="{Binding ScreenRecordingStatus}" Margin="12,0,0,0"
                   Classes.ok="{Binding ScreenRecording}" />
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
          <Button Classes="small onTint" Content="{l:T Permissions.Request}" Command="{Binding RequestScreenRecordingCommand}" />
          <Button Classes="small onTint" Content="{l:T Permissions.OpenScreenRecording}" Command="{Binding OpenScreenRecordingCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Classes="subtle">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <TextBlock FontWeight="SemiBold" Text="{Binding AccessibilityUse}" TextWrapping="Wrap" />
        <TextBlock Grid.Column="1" Name="AccessibilityState" Text="{Binding AccessibilityStatus}" Margin="12,0,0,0"
                   Classes.ok="{Binding Accessibility}" />
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
          <Button Classes="small onTint" Content="{l:T Permissions.OpenAccessibility}" Command="{Binding OpenAccessibilityCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <StackPanel Spacing="4">
      <TextBlock Classes="section" Text="{l:T Permissions.Steps}" />
      <TextBlock TextWrapping="Wrap" Text="{l:T Permissions.Step1}" />
      <TextBlock TextWrapping="Wrap" Text="{l:T Permissions.Step2}" />
      <TextBlock TextWrapping="Wrap" Text="{l:T Permissions.Step3}" />
      <TextBlock Classes="muted" Text="{Binding RestartNote}" />
    </StackPanel>

  </StackPanel>

  <Grid Grid.Row="1" ColumnDefinitions="*,1,*">
    <Button Name="RecheckButton" Classes="footer" Content="{l:T Permissions.Recheck}" Command="{Binding RecheckCommand}" />
    <Button Grid.Column="2" Classes="accent footer" Content="{l:T Permissions.Done}" Command="{Binding CloseCommand}" />
  </Grid>
  </Grid>

  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBlock.ok">
      <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="20" />
    </Style>
    <Style Selector="TextBlock.section, TextBlock.muted">
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Styles>
</Window>
