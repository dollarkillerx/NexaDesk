<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NexaDesk.ViewModels"
        xmlns:l="using:NexaDesk.Localization"
        xmlns:v="using:NexaDesk.Views"
        xmlns:svc="using:NexaDesk.Services"
        x:Class="NexaDesk.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="NexaDesk"
        Width="1040" Height="760" MinWidth="860" MinHeight="600">
  <Grid ColumnDefinitions="208,*">
    <!-- Sidebar: one page per thing a person comes to do, and whether this computer can be reached. -->
    <Border Classes="sidebar">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="2" Margin="16,18,16,18">
          <TextBlock FontSize="16" LetterSpacing="0.1">
            <Run Text="Nexa" /><Run Text="Desk" FontWeight="SemiBold" />
          </TextBlock>
          <TextBlock Classes="muted" Name="DeviceNameText" TextTrimming="CharacterEllipsis" Text="{Binding DeviceName, StringFormat={l:T Settings.ThisDevice}}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="2">
          <Button Name="NavConnectButton" Classes="nav" Classes.selected="{Binding IsConnectPage}" Command="{Binding ShowPageCommand}" CommandParameter="Connect">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Path Classes="icon navIcon" Data="{StaticResource IconConnect}" />
              <TextBlock Text="{l:T Nav.Connect}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Name="NavHostButton" Classes="nav" Classes.selected="{Binding IsHostPage}" Command="{Binding ShowPageCommand}" CommandParameter="Host">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Path Classes="icon navIcon" Data="{StaticResource IconMonitor}" />
              <TextBlock Text="{l:T Nav.Host}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Name="NavPairedButton" Classes="nav" Classes.selected="{Binding IsPairedPage}" Command="{Binding ShowPageCommand}" CommandParameter="Paired">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Path Classes="icon navIcon" Data="{StaticResource IconScreens}" />
              <TextBlock Text="{l:T Nav.Paired}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Name="NavSettingsButton" Classes="nav" Classes.selected="{Binding IsSettingsPage}" Command="{Binding ShowPageCommand}" CommandParameter="Settings">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Path Classes="icon navIcon" Data="{StaticResource IconSliders}" />
              <TextBlock Text="{l:T Nav.Settings}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        <Button Grid.Row="2" Name="HostStatusButton" Classes="nav status" Command="{Binding ShowPageCommand}" CommandParameter="Host" Margin="0,0,0,12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource OkBrush}" IsVisible="{Binding Host.IsHosting}" />
            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource MutedBrush}" IsVisible="{Binding !Host.IsHosting}" />
            <TextBlock Name="SidebarStateText" Classes="muted" Text="{Binding Host.ShortStateText}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
    <Panel Grid.Column="1" Background="{DynamicResource CardBrush}">
      <!-- Connect -->
      <ScrollViewer Name="ConnectPage" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsConnectPage}">
        <Border Classes="page" DataContext="{Binding Connect}" x:DataType="vm:ConnectViewModel">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Classes="iconTile">
                <Path Classes="icon" Data="{StaticResource IconConnect}" />
              </Border>
              <TextBlock Classes="h2" Text="{l:T Nav.Connect}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Intro}" Margin="0,4,0,0" />

            <TextBlock Classes="label" Text="{l:T Connect.Address}" Margin="0,12,0,0" />
            <TextBox Name="AddressBox" Text="{Binding Address}" PlaceholderText="{Binding AddressPlaceholder}"
                     IsEnabled="{Binding !IsConnecting}" />
            <TextBlock Classes="errorText" Text="{Binding AddressHint}" IsVisible="{Binding AddressHint, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <TextBlock Classes="label" Text="{l:T Main.CodeOrPassword}" Margin="0,6,0,0" />
            <TextBox Name="CodeBox" Classes="revealPasswordButton" Text="{Binding Code}" PlaceholderText="ABCD-2345" MaxLength="128"
                     PasswordChar="•" FontFamily="{DynamicResource MonoFont}" FontSize="16" IsEnabled="{Binding !IsConnecting}" />
            <TextBlock Classes="errorText" Text="{Binding CodeHint}" IsVisible="{Binding CodeHint, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <CheckBox Name="RememberPasswordBox" Content="{l:T Connect.RememberPassword}" IsChecked="{Binding RememberPassword}"
                      IsVisible="{Binding CodeIsPassword}" ToolTip.Tip="{l:T Connect.RememberPasswordTip}" />

            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
              <Button Name="ConnectButton" Classes="accent wide" Content="{l:T Main.Connect}" Command="{Binding ConnectCommand}" IsDefault="True"
                      IsVisible="{Binding !IsConnecting}" />
              <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding IsConnecting}" VerticalAlignment="Center" />
              <TextBlock Classes="muted" Text="{Binding ProgressText}" VerticalAlignment="Center" MaxWidth="300"
                         IsVisible="{Binding IsConnecting}" />
              <Button Name="CancelButton" Classes="small" Content="{l:T Connect.Cancel}" Command="{Binding CancelCommand}" IsVisible="{Binding IsConnecting}" />
            </StackPanel>

            <Border Name="ConnectError" Classes="error" IsVisible="{Binding HasError}" Margin="0,6,0,0">
              <StackPanel Spacing="3">
                <TextBlock Classes="errorTitle" Text="{Binding Error.Title, FallbackValue=''}" />
                <TextBlock Classes="errorText" Text="{Binding Error.Detail, FallbackValue=''}" />
              </StackPanel>
            </Border>
            <Border Classes="error" IsVisible="{Binding IdentityError, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Classes="errorText" Text="{Binding IdentityError}" />
            </Border>

            <StackPanel Name="LanSection" Spacing="4" Margin="0,14,0,0" IsVisible="{Binding HasLan}">
              <TextBlock Classes="section" Text="{l:T Connect.LanDevices}" Margin="0,0,0,2" />
              <ItemsControl Name="LanList" ItemsSource="{Binding Lan}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LanDeviceViewModel">
                    <Border Classes="item" Margin="0,0,0,6">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Classes="iconTile small" Margin="0,0,10,0">
                          <Path Classes="icon" Data="{StaticResource IconMonitor}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                          <TextBlock Classes="itemTitle" Text="{Binding Name}" />
                          <TextBlock Classes="muted" Text="{Binding Detail}" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="small tertiary" Content="{l:T Main.Connect}" Command="{Binding ConnectCommand}"
                                VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Name="TailnetSection" Spacing="4" Margin="0,14,0,0" IsVisible="{Binding HasTailnet}">
              <TextBlock Classes="section" Text="{l:T Connect.TailnetDevices}" Margin="0,0,0,2" />
              <ItemsControl Name="TailnetList" ItemsSource="{Binding Tailnet}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TailnetDeviceViewModel">
                    <Border Classes="item" Margin="0,0,0,6">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Classes="iconTile small" Margin="0,0,10,0">
                          <Path Classes="icon" Data="{StaticResource IconMonitor}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="itemTitle" Text="{Binding Name}" />
                            <Border Classes="badge">
                              <TextBlock Text="{Binding PathText}" />
                            </Border>
                          </StackPanel>
                          <TextBlock Classes="muted" Text="{Binding Detail}" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="small tertiary" Content="{l:T Main.Connect}" Command="{Binding ConnectCommand}"
                                VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <Border Name="ConnectTailscaleAdvice" Classes="tint" Margin="0,14,0,0"
                    IsVisible="{Binding ShowTailscaleAdvice}">
              <StackPanel Spacing="6">
                <TextBlock FontWeight="SemiBold" Text="{l:T Connect.TailscaleAdviceTitle}" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="{l:T Connect.TailscaleAdvice}" />
                <Button Classes="small onTint" Content="{l:T Main.DownloadTailscale}" Command="{Binding Tailscale.DownloadCommand}" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>

            <TextBlock Classes="section" Text="{l:T Connect.Recent}" Margin="0,14,0,2" />
            <TextBlock Classes="muted" Text="{l:T Connect.NoRecent}" IsVisible="{Binding !HasRecent}" />

            <ItemsControl Name="RecentList" ItemsSource="{Binding Recent}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RecentDeviceViewModel">
                  <Border Classes="item" Margin="0,0,0,6">
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                      <Border Classes="iconTile small" Margin="0,0,10,0">
                        <Path Classes="icon" Data="{StaticResource IconMonitor}" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Classes="itemTitle" Text="{Binding Name}" />
                          <Border Classes="badge">
                            <TextBlock Text="{Binding PairedText}" />
                          </Border>
                          <Border Classes="badge" IsVisible="{Binding HasPassword}">
                            <TextBlock Text="{l:T Connect.PasswordSaved}" />
                          </Border>
                        </StackPanel>
                        <TextBlock Classes="muted" Text="{Binding Address}" />
                        <TextBlock Classes="muted" Text="{Binding LastSeen, StringFormat={l:T Main.LastConnected}}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Classes="small tertiary" Content="{l:T Main.Connect}" Command="{Binding ConnectCommand}" />
                        <Button Classes="small ghost" Content="{l:T Connect.Edit}" Command="{Binding EditCommand}" />
                      </StackPanel>
                      <!-- Its name, its kept password, or away with it. -->
                      <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Spacing="6" Margin="0,10,0,0" IsVisible="{Binding IsEditing}">
                        <TextBlock Classes="label" Text="{l:T Connect.EditName}" />
                        <TextBox Text="{Binding EditLabel}" PlaceholderText="{Binding HostName}" MaxLength="64" />
                        <TextBlock Classes="label" Text="{l:T Connect.EditPassword}" />
                        <TextBox Classes="revealPasswordButton" Text="{Binding EditPassword}" PasswordChar="•" MaxLength="128"
                                 PlaceholderText="{l:T Connect.EditPasswordPlaceholder}" IsEnabled="{Binding !ForgetPassword}" />
                        <CheckBox Content="{l:T Connect.ForgetPassword}" IsChecked="{Binding ForgetPassword}" IsVisible="{Binding HasPassword}" />
                        <TextBlock Classes="errorText" Text="{Binding EditError}" IsVisible="{Binding EditError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Button Classes="small accent" Content="{l:T Connect.Save}" Command="{Binding SaveEditCommand}" />
                          <Button Classes="small" Content="{l:T Connect.Cancel}" Command="{Binding CancelEditCommand}" />
                          <Button Classes="small danger" Content="{l:T Connect.Remove}" Command="{Binding RemoveCommand}" Margin="16,0,0,0" />
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </ScrollViewer>
      <!-- Host -->
      <ScrollViewer Name="HostPage" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsHostPage}">
        <Border Classes="page" DataContext="{Binding Host}" x:DataType="vm:HostViewModel">
          <Border.Resources>
            <!-- One address: its network, the address (click to copy), a line about it. -->
            <DataTemplate x:Key="AddressRow" x:DataType="vm:ConnectOption">
              <Grid ColumnDefinitions="80,*" Margin="0,0,0,2">
                <Border Classes="badge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,7,0,0">
                  <TextBlock Text="{Binding Kind}" />
                </Border>
                <Button Grid.Column="1" Classes="copy" ToolTip.Tip="{l:T Host.ClickToCopy}" Margin="-8,0,0,0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Command="{Binding $parent[ItemsControl].((vm:HostViewModel)DataContext).CopyCommand}"
                        CommandParameter="{Binding Address}">
                  <StackPanel Spacing="1">
                    <!-- The whole row copies; the hint keeps to the right edge, so a long address (a
                         browser's MagicDNS URL) wraps at the card's edge instead of running off it. -->
                    <Grid ColumnDefinitions="*,Auto">
                      <Panel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Path Classes="icon copyHint" Data="{StaticResource IconCopy}">
                          <Path.IsVisible>
                            <MultiBinding Converter="{x:Static v:Same.Differ}">
                              <Binding Path="Address" />
                              <Binding Path="$parent[ItemsControl].((vm:HostViewModel)DataContext).Copied" />
                            </MultiBinding>
                          </Path.IsVisible>
                        </Path>
                        <Path Classes="icon copied" Data="{StaticResource IconCheck}" ToolTip.Tip="{l:T Host.Copied}">
                          <Path.IsVisible>
                            <MultiBinding Converter="{x:Static v:Same.Values}">
                              <Binding Path="Address" />
                              <Binding Path="$parent[ItemsControl].((vm:HostViewModel)DataContext).Copied" />
                            </MultiBinding>
                          </Path.IsVisible>
                        </Path>
                      </Panel>
                      <TextBlock Text="{Binding Address}" FontFamily="{DynamicResource MonoFont}" FontSize="15" TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock Classes="muted" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" TextWrapping="Wrap" />
                  </StackPanel>
                </Button>
              </Grid>
            </DataTemplate>
          </Border.Resources>
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Classes="iconTile">
                  <Path Classes="icon" Data="{StaticResource IconMonitor}" />
                </Border>
                <TextBlock Classes="h2" Text="{l:T Nav.Host}" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Name="StartHostingButton" Classes="accent" Content="{l:T Host.Start}" Command="{Binding StartCommand}" IsVisible="{Binding IsStopped}" />
                <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding IsStarting}" VerticalAlignment="Center" />
                <Button Name="StopHostingButton" Classes="danger" Content="{l:T Host.Stop}" Command="{Binding StopCommand}" IsVisible="{Binding IsHosting}" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
              <!-- Green while others can connect. -->
              <Ellipse Width="8" Height="8" Margin="1,4,8,0" VerticalAlignment="Top" Fill="{DynamicResource OkBrush}" IsVisible="{Binding IsHosting}" />
              <TextBlock Grid.Column="1" Classes="muted" TextWrapping="Wrap" Text="{Binding StateText}" />
            </Grid>
            <StackPanel Spacing="8" IsVisible="{Binding IsHosting}">
              <!-- First: without it the other person can only watch. -->
              <Border Classes="warn" IsVisible="{Binding !InputAvailable}" Name="NoAccessibilityWarning" Margin="0,6,0,0">
                <StackPanel Spacing="4">
                  <TextBlock TextWrapping="Wrap" Text="{l:T Host.NoAccessibility}" />
                  <Button Classes="small onTint" Content="{l:T Host.HowToGrant}" Command="{Binding ShowPermissionGuideCommand}" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
              <Border Name="CredentialsCard" Classes="subtle" Padding="16,12,14,14" Margin="0,6,0,0">
                <StackPanel Spacing="2">
                  <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasDeviceId}">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <TextBlock Classes="label" Text="{l:T Host.KindDeviceId}" />
                      <TextBlock Classes="muted" Text="{l:T Host.ViaServer}" />
                    </StackPanel>
                    <Button Grid.Column="1" Name="ResetIdButton" Classes="small ghost" Content="{l:T Host.ResetId}"
                            Command="{Binding AskResetDeviceIdCommand}" IsVisible="{Binding !IsConfirmingIdReset}" />
                  </Grid>
                  <Border Name="ResetIdConfirm" Classes="warn" IsVisible="{Binding IsConfirmingIdReset}" Margin="0,4,0,4">
                    <StackPanel Spacing="8">
                      <TextBlock TextWrapping="Wrap" Text="{l:T Host.ResetIdConfirm}" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Name="ConfirmResetIdButton" Classes="small danger" Content="{l:T Host.ResetIdOk}" Command="{Binding ResetDeviceIdCommand}" />
                        <Button Classes="small ghost" Content="{l:T Host.ResetIdCancel}" Command="{Binding CancelResetDeviceIdCommand}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <Button Name="DeviceIdButton" Classes="copy big" IsVisible="{Binding HasDeviceId}" Margin="-8,0,0,8"
                          ToolTip.Tip="{l:T Host.ClickToCopy}" Command="{Binding CopyCommand}" CommandParameter="{Binding DeviceId}">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                      <TextBlock Name="DeviceIdText" Classes="big" Text="{Binding DeviceIdDisplay}" />
                      <Panel VerticalAlignment="Center">
                        <TextBlock Classes="copyHint" Text="{l:T Host.ClickToCopy}">
                          <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static v:Same.Differ}">
                              <Binding Path="DeviceId" />
                              <Binding Path="Copied" />
                            </MultiBinding>
                          </TextBlock.IsVisible>
                        </TextBlock>
                        <TextBlock Classes="copied" Text="{l:T Host.Copied}">
                          <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static v:Same.Values}">
                              <Binding Path="DeviceId" />
                              <Binding Path="Copied" />
                            </MultiBinding>
                          </TextBlock.IsVisible>
                        </TextBlock>
                      </Panel>
                    </StackPanel>
                  </Button>
                  <TextBlock Classes="label" Text="{l:T Main.OneTimeCode}" />
                  <Grid ColumnDefinitions="*,Auto">
                    <Button Name="CodeButton" Classes="copy big" Margin="-8,0,0,0"
                            ToolTip.Tip="{l:T Host.ClickToCopy}" Command="{Binding CopyCommand}" CommandParameter="{Binding CodeDisplay}">
                      <StackPanel Orientation="Horizontal" Spacing="14">
                        <TextBlock Name="CodeText" Classes="big" Text="{Binding CodeDisplay}" />
                        <Panel VerticalAlignment="Center">
                          <TextBlock Classes="copyHint" Text="{l:T Host.ClickToCopy}">
                            <TextBlock.IsVisible>
                              <MultiBinding Converter="{x:Static v:Same.Differ}">
                                <Binding Path="CodeDisplay" />
                                <Binding Path="Copied" />
                              </MultiBinding>
                            </TextBlock.IsVisible>
                          </TextBlock>
                          <TextBlock Classes="copied" Text="{l:T Host.Copied}">
                            <TextBlock.IsVisible>
                              <MultiBinding Converter="{x:Static v:Same.Values}">
                                <Binding Path="CodeDisplay" />
                                <Binding Path="Copied" />
                              </MultiBinding>
                            </TextBlock.IsVisible>
                          </TextBlock>
                        </Panel>
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Name="RotateButton" Classes="small onTint" Content="{l:T Host.RotateCode}" Command="{Binding RotateCodeCommand}"
                            VerticalAlignment="Center" Margin="10,0,0,0" />
                  </Grid>
                </StackPanel>
              </Border>
              <TextBlock Name="SignalStatusText" Classes="muted" TextWrapping="Wrap" Text="{Binding SignalText}">
                <TextBlock.IsVisible>
                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="HasSignalText" />
                    <Binding Path="!SignalProblem" />
                  </MultiBinding>
                </TextBlock.IsVisible>
              </TextBlock>
              <TextBlock Classes="errorText" TextWrapping="Wrap" Text="{Binding SignalText}" IsVisible="{Binding SignalProblem}" />
              <TextBlock Classes="errorText" TextWrapping="Wrap" IsVisible="{Binding RestartNeeded}"
                         Text="{l:T Host.RestartNeeded}" />
              <TextBlock Classes="section" Text="{l:T Host.AddressesTitle}" Margin="0,14,0,2" />
              <!-- Per way in, the addresses most people need; the rest (bridges to VMs and
                   containers) folded under a link. -->
              <Border Name="AppAddressGroup" Classes="subtle" Padding="14,10,14,8" IsVisible="{Binding !AppAddresses.IsEmpty}">
                <StackPanel Spacing="2">
                  <TextBlock Classes="label" Text="{l:T Host.AppAddresses}" Margin="0,0,0,4" />
                  <ItemsControl Name="ConnectOptionsList" ItemsSource="{Binding AppAddresses.Main}" ItemTemplate="{StaticResource AddressRow}" />
                  <ItemsControl Name="MoreAppAddressList" ItemsSource="{Binding AppAddresses.More}" ItemTemplate="{StaticResource AddressRow}"
                                IsVisible="{Binding AppAddresses.Expanded}" />
                  <Button Name="MoreAppAddressesButton" Classes="small link" HorizontalAlignment="Left" Margin="-8,0,0,0"
                          Content="{Binding AppAddresses.MoreText}" Command="{Binding AppAddresses.ToggleMoreCommand}"
                          IsVisible="{Binding AppAddresses.HasMore}" />
                </StackPanel>
              </Border>
              <Border Name="WebAddressGroup" Classes="subtle" Padding="14,10,14,8" Margin="0,8,0,0" IsVisible="{Binding !WebAddresses.IsEmpty}">
                <StackPanel Spacing="2">
                  <TextBlock Classes="label" Text="{l:T Host.WebAddresses}" />
                  <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding WebAddresses.Note}" IsVisible="{Binding WebAddresses.HasNote}" />
                  <ItemsControl Name="WebAddressList" ItemsSource="{Binding WebAddresses.Main}" ItemTemplate="{StaticResource AddressRow}" Margin="0,4,0,0" />
                  <ItemsControl Name="MoreWebAddressList" ItemsSource="{Binding WebAddresses.More}" ItemTemplate="{StaticResource AddressRow}"
                                IsVisible="{Binding WebAddresses.Expanded}" />
                  <Button Name="MoreWebAddressesButton" Classes="small link" HorizontalAlignment="Left" Margin="-8,0,0,0"
                          Content="{Binding WebAddresses.MoreText}" Command="{Binding WebAddresses.ToggleMoreCommand}"
                          IsVisible="{Binding WebAddresses.HasMore}" />
                </StackPanel>
              </Border>
            </StackPanel>
            <Border Name="HostError" Classes="error" IsVisible="{Binding HasError}">
              <StackPanel Spacing="6">
                <TextBlock Classes="errorText" Text="{Binding Error}" />
                <Button Classes="small" Content="{l:T Host.PermissionGuide}" Command="{Binding ShowPermissionGuideCommand}" />
              </StackPanel>
            </Border>
            <TextBlock Classes="muted" Text="{Binding Notice}" IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <!-- Tailscale: how people outside the LAN get here, with no server of ours -->
            <Border Name="HostTailscaleStatus" Classes="ok" IsVisible="{Binding Tailscale.IsPresent}">
              <StackPanel Spacing="2">
                <TextBlock FontWeight="SemiBold" Text="{Binding Tailscale.StatusText}" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="{l:T Host.TailscaleStatus}" />
              </StackPanel>
            </Border>
            <Border Name="HostTailscaleAdvice" Classes="tint"
                    IsVisible="{Binding ShowTailscaleAdvice}">
              <StackPanel Spacing="6">
                <TextBlock FontWeight="SemiBold" Text="{l:T Host.TailscaleAdviceTitle}" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="{l:T Host.TailscaleAdvice}" />
                <Button Classes="small onTint" Content="{l:T Main.DownloadTailscale}" Command="{Binding Tailscale.DownloadCommand}" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>

          </StackPanel>
        </Border>
      </ScrollViewer>
      <!-- Paired -->
      <ScrollViewer Name="PairedPage" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsPairedPage}">
        <Border Classes="page" DataContext="{Binding Host}" x:DataType="vm:HostViewModel">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="h2" Text="{l:T Nav.Paired}" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="small ghost" Content="{l:T Host.Refresh}" Command="{Binding RefreshPairingsCommand}" IsVisible="{Binding IsHosting}" />
            </Grid>
            <TextBlock Name="NoPairedText" Classes="muted" TextWrapping="Wrap" Text="{l:T Host.NoPairedDevices}"
                       IsVisible="{Binding NoPairedDevices}" />
            <ItemsControl Name="PairedList" ItemsSource="{Binding Paired}" IsVisible="{Binding IsHosting}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PairedDeviceViewModel">
                  <Border Classes="item" Margin="0,0,0,6">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Classes="iconTile small" Margin="0,0,10,0" VerticalAlignment="Top">
                        <Path Classes="icon" Data="{StaticResource IconMonitor}" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Classes="itemTitle" Text="{Binding Name}" />
                        <TextBlock Classes="muted" Text="{Binding PermsText, StringFormat={l:T Host.Perms}}" />
                        <TextBlock Classes="muted" Text="{Binding ConsentText}" />
                        <TextBlock Classes="muted" FontFamily="{DynamicResource MonoFont}" Text="{Binding Fingerprint, StringFormat={l:T Host.Fingerprint}}" />
                        <TextBlock Classes="muted" Text="{Binding LastSeen, StringFormat={l:T Main.LastConnected}}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Button Classes="small danger" Content="{l:T Host.Revoke}" Command="{Binding RevokeCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                        <Button Classes="small onTint" Content="{l:T Host.RequireConsent}" Command="{Binding RequireConsentCommand}" IsVisible="{Binding Unattended}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Name="PairedNeedsHostingText" Classes="muted" TextWrapping="Wrap" Text="{l:T Host.PairedNeedsHosting}" IsVisible="{Binding !IsHosting}" />
          </StackPanel>
        </Border>
      </ScrollViewer>
      <!-- Settings -->
      <ScrollViewer Name="SettingsPage" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsSettingsPage}">
        <Border Classes="page">
          <StackPanel Spacing="22">
            <TextBlock Classes="h2" Text="{l:T Nav.Settings}" />
            <StackPanel Spacing="10">
              <TextBlock Classes="settingsHeading" Text="{l:T Settings.General}" />
              <Border Classes="card settingsGroup">
                <StackPanel Spacing="14">
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,8,0"
                              DataContext="{Binding Settings}" x:DataType="vm:SettingsViewModel">
                    <TextBlock Classes="muted" Name="LanguageRestartText" Text="{l:T Settings.LanguageRestart}" VerticalAlignment="Center"
                               IsVisible="{Binding LanguageRestartNeeded}" />
                    <Path Classes="icon muted" Data="{StaticResource IconGlobe}" Width="16" Height="16" />
                    <TextBlock Classes="label" Text="{l:T Settings.Language}" VerticalAlignment="Center" />
                    <ComboBox Name="LanguageBox" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}" MinWidth="140"
                              MinHeight="32" VerticalAlignment="Center">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LanguageOption">
                          <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Spacing="4" DataContext="{Binding LoginItem}" x:DataType="vm:LoginItemViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <CheckBox Name="LoginItemBox" Content="{l:T Main.LoginItem}" IsChecked="{Binding IsEnabled}" IsEnabled="{Binding IsSupported}" />
                      <TextBlock Classes="muted" Name="LoginItemStatus" Text="{Binding StatusText}" VerticalAlignment="Center" />
                      <Button Classes="small" Content="{l:T Main.OpenLoginItems}" Command="{Binding OpenSettingsCommand}" IsVisible="{Binding NeedsApproval}" />
                      <TextBlock Classes="errorText" Text="{Binding Error}" VerticalAlignment="Center"
                                 IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                  </StackPanel>
                  <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:T Main.MenuBarNote}" />
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel Spacing="10">
              <TextBlock Classes="settingsHeading" Text="{l:T Settings.HostSection}" />
              <Border Classes="card settingsGroup">
                <StackPanel Spacing="14">
                  <StackPanel Spacing="4" DataContext="{Binding Host}" x:DataType="vm:HostViewModel">
                    <TextBlock Classes="label" Text="{l:T Host.FixedPassword}" />
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !IsEditingPassword}">
                      <TextBlock Name="PasswordStateText" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center"
                                 Text="{Binding PasswordStateText}" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="10,0,0,0" VerticalAlignment="Center">
                        <Button Name="EditPasswordButton" Classes="small" Content="{Binding PasswordEditLabel}" Command="{Binding EditPasswordCommand}" />
                        <Button Name="ClearPasswordButton" Classes="small ghost" Content="{l:T Host.ClearPassword}"
                                Command="{Binding ClearPasswordCommand}" IsVisible="{Binding PasswordSet}" />
                      </StackPanel>
                    </Grid>
                    <StackPanel Spacing="6" IsVisible="{Binding IsEditingPassword}">
                      <TextBox Name="NewPasswordBox" Classes="revealPasswordButton" PasswordChar="•" MaxLength="128"
                               Text="{Binding NewPassword}" PlaceholderText="{l:T Host.NewPassword}" />
                      <TextBox Name="ConfirmPasswordBox" Classes="revealPasswordButton" PasswordChar="•" MaxLength="128"
                               Text="{Binding ConfirmPassword}" PlaceholderText="{l:T Host.ConfirmPassword}" />
                      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:T Host.PasswordNote}" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Name="SavePasswordButton" Classes="small accent" Content="{l:T Host.SavePassword}" Command="{Binding SavePasswordCommand}" />
                        <Button Classes="small ghost" Content="{l:T Host.CancelPassword}" Command="{Binding CancelPasswordCommand}" />
                      </StackPanel>
                    </StackPanel>
                    <TextBlock Classes="errorText" TextWrapping="Wrap" Text="{Binding PasswordError}"
                               IsVisible="{Binding PasswordError, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,2,0,0" Text="{l:T Host.ConfirmNote}" />
                  </StackPanel>
                  <StackPanel Spacing="2">
                    <CheckBox Name="AnnounceOnLanBox" Content="{l:T Main.AnnounceOnLan}" IsChecked="{Binding Settings.AnnounceOnLan}" />
                    <TextBlock Classes="muted" TextWrapping="Wrap" Margin="28,0,0,0" Text="{l:T Main.AnnounceOnLanTip}" />
                  </StackPanel>
                  <StackPanel Spacing="2">
                    <CheckBox Name="AllowBrowsersBox" Content="{l:T Main.AllowBrowsers}" IsChecked="{Binding Settings.AllowBrowsers}" />
                    <TextBlock Classes="muted" TextWrapping="Wrap" Margin="28,0,0,0" Text="{l:T Main.AllowBrowsersTip}" />
                  </StackPanel>
                  <StackPanel Spacing="2">
                    <CheckBox Name="AllowAgentsBox" Content="{l:T Main.AllowAgents}" IsChecked="{Binding Settings.AllowAgents}" />
                    <TextBlock Classes="muted" TextWrapping="Wrap" Margin="28,0,0,0" Text="{l:T Main.AllowAgentsTip}" />
                  </StackPanel>
                  <StackPanel DataContext="{Binding Host}" x:DataType="vm:HostViewModel">
                    <!-- Stopped: where to listen. Every network by default; one address is the exception. -->
                    <Expander Name="ListenExpander" HorizontalAlignment="Stretch">
                      <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <TextBlock Classes="label" Text="{l:T Host.ListenRange}" VerticalAlignment="Center" />
                          <TextBlock Classes="muted" Name="ListenSummaryText" Text="{Binding ListenSummary}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Expander.Header>
                      <StackPanel Spacing="6">
                        <RadioButton GroupName="listen" Name="ListenEverywhereRadio" IsChecked="{Binding ListenEverywhere}" IsEnabled="{Binding IsStopped}"
                                     Content="{l:T Host.ListenEverywhere}" />
                        <RadioButton GroupName="listen" Name="ListenOnOneRadio" IsChecked="{Binding ListenOnOne}" IsEnabled="{Binding IsStopped}"
                                     Content="{l:T Host.ListenOnOne}" />
                        <StackPanel Spacing="6" Margin="26,0,0,0" IsVisible="{Binding ListenOnOne}">
                          <TextBox Name="ListenBox" Text="{Binding ListenAddress}" IsEnabled="{Binding IsStopped}" />
                          <TextBlock Classes="errorText" Text="{Binding ListenHint}" IsVisible="{Binding ListenHint, Converter={x:Static ObjectConverters.IsNotNull}}" />
                          <ItemsControl ItemsSource="{Binding AddressSuggestions}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="x:String">
                                <Button Classes="small" Margin="0,0,6,6" Content="{Binding}"
                                        Command="{Binding $parent[ItemsControl].((vm:HostViewModel)DataContext).UseSuggestionCommand}"
                                        CommandParameter="{Binding}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:T Host.ListenOnOneHelp}" />
                        </StackPanel>
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel Spacing="10">
              <TextBlock Classes="settingsHeading" Text="{l:T Settings.Network}" />
              <Border Classes="card settingsGroup">
                <StackPanel Spacing="14">
                  <Expander Name="AdvancedExpander" Margin="0,2,0,0" HorizontalAlignment="Stretch"
                            DataContext="{Binding Settings}" x:DataType="vm:SettingsViewModel">
                    <Expander.Header>
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="label" Text="{l:T Main.Advanced}" VerticalAlignment="Center" />
                        <TextBlock Classes="muted" Name="ServerStatusText" Text="{Binding ServerStatus}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="6">
                      <TextBlock Classes="muted" TextWrapping="Wrap"
                                 Text="{l:T Main.AdvancedHelp}" />
                      <RadioButton Name="ModeNoneButton" GroupName="ServerMode" Content="{l:T Main.ModeNone}" IsChecked="{Binding IsModeNone}" />
                      <RadioButton Name="ModePublishedButton" GroupName="ServerMode" Content="{l:T Main.ModePublished}"
                                   IsChecked="{Binding IsModePublished}" IsVisible="{Binding CanUseServerList}" />
                      <StackPanel Orientation="Horizontal" Spacing="10" Margin="30,0,0,4" IsVisible="{Binding IsModePublished}">
                        <ComboBox Name="ListedServersBox" ItemsSource="{Binding ListedServers}" SelectedItem="{Binding SelectedListed}"
                                  Width="320" PlaceholderText="{l:T Main.ServerListPick}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ListedServer">
                              <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{Binding Endpoint}" />
                                <TextBlock Classes="muted" Text="{Binding Health}" />
                              </StackPanel>
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Classes="muted" Name="ListStatusText" Text="{Binding ListStatus}" VerticalAlignment="Center" TextWrapping="Wrap" />
                      </StackPanel>
                      <RadioButton Name="ModeOwnButton" GroupName="ServerMode" Content="{l:T Main.ModeOwn}" IsChecked="{Binding IsModeOwn}" />
                      <StackPanel Spacing="6" Margin="30,0,0,4" IsVisible="{Binding IsModeOwn}">
                        <Grid ColumnDefinitions="Auto,320" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="6" HorizontalAlignment="Left">
                          <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="{l:T Main.SignalServer}" VerticalAlignment="Center" />
                          <TextBox Grid.Row="0" Grid.Column="1" Name="ServerBox" Text="{Binding ServerInput}" PlaceholderText="wss://signal.example.com" />
                          <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="{l:T Main.SignalSecret}" VerticalAlignment="Center" />
                          <TextBox Grid.Row="1" Grid.Column="1" Name="SecretBox" Text="{Binding SecretInput}" PasswordChar="●"
                                   PlaceholderText="{l:T Main.SecretPlaceholder}" />
                        </Grid>
                        <TextBlock Classes="errorText" Text="{Binding ServerHint}" IsVisible="{Binding ServerHint, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock Classes="errorText" TextWrapping="Wrap" Text="{Binding SecretHint}" IsVisible="{Binding SecretHint, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <Button Name="SaveServerButton" Classes="small" Content="{l:T Main.Save}" Command="{Binding SaveCommand}" />
                          <Button Name="TestServerButton" Classes="small" Content="{l:T Main.ProbeButton}" Command="{Binding TestCommand}" />
                          <TextBlock Classes="muted" Name="TestResultText" Text="{Binding TestResult}" VerticalAlignment="Center"
                                     IsVisible="{Binding TestResult, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                      </StackPanel>
                      <TextBlock Classes="errorText" TextWrapping="Wrap" Text="{Binding SecretError}" IsVisible="{Binding SecretError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                  </Expander>
                  <!-- AI 代理：把本应用旁边的 nexa-mcp 交给本机的 AI（docs/MCP.md） -->
                  <Expander Name="McpExpander" Margin="0,2,0,0" HorizontalAlignment="Stretch"
                            DataContext="{Binding Mcp}" x:DataType="vm:McpViewModel">
                    <Expander.Header>
                      <TextBlock Classes="label" Text="{l:T Main.Mcp}" VerticalAlignment="Center" />
                    </Expander.Header>
                    <StackPanel Spacing="8">
                      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:T Main.McpHelp}" />
                      <Border Classes="warn" IsVisible="{Binding IsMissing}">
                        <TextBlock Name="McpMissingText" TextWrapping="Wrap" Text="{l:T Main.McpMissing}" />
                      </Border>
                      <TextBlock Classes="label" Text="{l:T Main.McpClaude}" />
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Name="McpCommandBox" IsReadOnly="True" Text="{Binding ClaudeCommand, Mode=OneWay}"
                                 FontFamily="{DynamicResource MonoFont}" FontSize="12" TextWrapping="Wrap" />
                        <Button Grid.Column="1" Classes="small" Name="McpCopyCommandButton" VerticalAlignment="Top"
                                Command="{Binding CopyCommand}" CommandParameter="{Binding ClaudeCommand}">
                          <Panel>
                            <TextBlock Text="{l:T Main.McpCopy}" IsVisible="{Binding !ClaudeCopied}" />
                            <TextBlock Text="{l:T Main.McpCopied}" IsVisible="{Binding ClaudeCopied}" />
                          </Panel>
                        </Button>
                      </Grid>
                      <TextBlock Classes="label" Text="{l:T Main.McpJson}" />
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Name="McpJsonBox" IsReadOnly="True" Text="{Binding JsonConfig, Mode=OneWay}"
                                 FontFamily="{DynamicResource MonoFont}" FontSize="12" TextWrapping="Wrap" />
                        <Button Grid.Column="1" Classes="small" Name="McpCopyJsonButton" VerticalAlignment="Top"
                                Command="{Binding CopyCommand}" CommandParameter="{Binding JsonConfig}">
                          <Panel>
                            <TextBlock Text="{l:T Main.McpCopy}" IsVisible="{Binding !JsonCopied}" />
                            <TextBlock Text="{l:T Main.McpCopied}" IsVisible="{Binding JsonCopied}" />
                          </Panel>
                        </Button>
                      </Grid>
                      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:T Main.McpOtherWay}" />
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel Spacing="10">
              <TextBlock Classes="settingsHeading" Text="{l:T Settings.KeyboardSection}" />
              <Border Classes="card settingsGroup">
                <StackPanel Spacing="14">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Name="KeyboardSettingsButton" Classes="small" Content="{l:T Main.KeyboardSettings}" Command="{Binding ShowKeyboardSettingsCommand}"
                            IsVisible="{Binding HasKeyboardSettings}" />
                    <Button Name="ViewerPermissionsButton" Classes="small" Content="{l:T Main.Permissions}" Command="{Binding ShowViewerPermissionsCommand}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel Spacing="10">
              <TextBlock Classes="settingsHeading" Text="{l:T Settings.AboutSection}" />
              <Border Classes="card settingsGroup">
                <StackPanel Spacing="14">
                  <StackPanel Orientation="Horizontal" Spacing="10" DataContext="{Binding Updates}" x:DataType="vm:UpdatesViewModel">
                    <TextBlock Classes="label" Name="VersionText" Text="{Binding CurrentVersion}" VerticalAlignment="Center" />
                    <TextBlock Classes="muted" Name="UpdateStatusText" Text="{Binding StatusText}" VerticalAlignment="Center" />
                    <Button Classes="small" Name="CheckUpdatesButton" Content="{l:T Updates.Check}" Command="{Binding CheckCommand}"
                            IsVisible="{Binding CanCheckNow}" />
                    <Button Classes="small" Name="RestartToUpdateButton" Content="{l:T Updates.Restart}" Command="{Binding RestartCommand}"
                            IsVisible="{Binding IsReady}" />
                    <!-- 关于：源代码、反馈、官网（与 iOS 的“关于”一致） -->
                    <StackPanel Orientation="Horizontal" Spacing="2" Margin="6,0,0,0"
                                DataContext="{Binding $parent[Window].((vm:MainViewModel)DataContext).About}" x:DataType="vm:AboutViewModel">
                      <Button Classes="small link" Name="RepositoryButton" Content="{l:T About.Source}" Command="{Binding OpenRepositoryCommand}"
                              ToolTip.Tip="github.com/dollarkillerx/NexaDesk" />
                      <Button Classes="small link" Name="IssuesButton" Content="{l:T About.Issues}" Command="{Binding OpenIssuesCommand}" />
                      <Button Classes="small link" Name="WebsiteButton" Content="{l:T About.Website}" Command="{Binding OpenWebsiteCommand}" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Spacing="3" DataContext="{Binding Connect}" x:DataType="vm:ConnectViewModel">
                    <StackPanel Spacing="3">
                      <TextBlock Classes="section" TextWrapping="Wrap" Text="{l:T Connect.Fingerprint}" />
                      <TextBlock Classes="mono" FontSize="12" Text="{Binding ThisDeviceFingerprint}" Foreground="{DynamicResource MutedBrush}" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>
        </Border>
      </ScrollViewer>
    </Panel>
  </Grid>
</Window>
