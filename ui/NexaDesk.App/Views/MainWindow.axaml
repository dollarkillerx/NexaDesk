<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NexaDesk.ViewModels"
        x:Class="NexaDesk.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="NexaDesk"
        Width="1040" Height="720" MinWidth="860" MinHeight="560">
  <Grid RowDefinitions="Auto,Auto,*" Margin="24,18,24,24">
    <!-- Header -->
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Classes="h1" Text="NexaDesk" />
        <TextBlock Classes="label" VerticalAlignment="Bottom" Margin="0,0,0,2"
                   Text="{Binding DeviceName, StringFormat='本机：{0}'}" />
      </StackPanel>
      <Button Grid.Column="1" Classes="small" Content="权限设置…" Command="{Binding ShowViewerPermissionsCommand}" />
    </Grid>

    <!-- 信令服务器：按设备 ID 连接时使用 -->
    <Border Grid.Row="1" Classes="subtle" Margin="0,0,0,14" DataContext="{Binding Settings}" x:DataType="vm:SettingsViewModel">
      <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Classes="label" Text="信令服务器" VerticalAlignment="Center" />
          <TextBox Name="ServerBox" Text="{Binding ServerInput}" Width="320" PlaceholderText="wss://signal.example.com" />
          <Button Name="SaveServerButton" Classes="small" Content="保存" Command="{Binding SaveCommand}" />
          <TextBlock Classes="muted" Name="ServerStatusText" Text="{Binding ServerStatus}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Classes="errorText" Text="{Binding ServerHint}" IsVisible="{Binding ServerHint, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,20,*">
      <!-- 连接到设备 -->
      <Border Classes="card" DataContext="{Binding Connect}" x:DataType="vm:ConnectViewModel">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="连接到设备" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="输入对方的设备 ID 或地址，以及对方 NexaDesk 窗口里显示的一次性码。" />

            <TextBlock Classes="label" Text="设备 ID 或地址" Margin="0,6,0,0" />
            <TextBox Name="AddressBox" Text="{Binding Address}" PlaceholderText="例如 123 456 789 或 192.168.1.20:47800"
                     IsEnabled="{Binding !IsConnecting}" />
            <TextBlock Classes="errorText" Text="{Binding AddressHint}" IsVisible="{Binding AddressHint, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <TextBlock Classes="label" Text="一次性码" Margin="0,4,0,0" />
            <TextBox Name="CodeBox" Text="{Binding Code}" PlaceholderText="ABCD-2345" MaxLength="12"
                     FontFamily="{StaticResource MonoFont}" FontSize="16" IsEnabled="{Binding !IsConnecting}" />
            <TextBlock Classes="errorText" Text="{Binding CodeHint}" IsVisible="{Binding CodeHint, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
              <Button Name="ConnectButton" Classes="accent" Content="连接" Command="{Binding ConnectCommand}" IsDefault="True"
                      IsVisible="{Binding !IsConnecting}" />
              <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding IsConnecting}" VerticalAlignment="Center" />
              <TextBlock Classes="muted" Text="{Binding ProgressText}" VerticalAlignment="Center" MaxWidth="300"
                         IsVisible="{Binding IsConnecting}" />
              <Button Name="CancelButton" Classes="small" Content="取消" Command="{Binding CancelCommand}" IsVisible="{Binding IsConnecting}" />
            </StackPanel>

            <Border Name="ConnectError" Classes="error" IsVisible="{Binding HasError}" Margin="0,6,0,0">
              <StackPanel Spacing="3">
                <TextBlock Classes="errorTitle" Text="{Binding Error.Title, FallbackValue=''}" />
                <TextBlock Classes="errorText" Text="{Binding Error.Detail, FallbackValue=''}" />
              </StackPanel>
            </Border>
            <Border Classes="error" IsVisible="{Binding IdentityError, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Classes="errorText" Text="{Binding IdentityError}" />
            </Border>

            <TextBlock Classes="label" Text="最近的设备" Margin="0,12,0,0" />
            <TextBlock Classes="muted" Text="还没有连接过任何设备。" IsVisible="{Binding !HasRecent}" />
          </StackPanel>

          <ScrollViewer Grid.Row="1" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl Name="RecentList" ItemsSource="{Binding Recent}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RecentDeviceViewModel">
                  <Border Classes="subtle" Margin="0,0,0,6">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                          <Border Classes="badge">
                            <TextBlock Text="{Binding PairedText}" FontSize="11" />
                          </Border>
                        </StackPanel>
                        <TextBlock Classes="muted" Text="{Binding Address}" />
                        <TextBlock Classes="muted" Text="{Binding LastSeen, StringFormat='上次连接：{0}'}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Classes="small" Content="连接" Command="{Binding ConnectCommand}" />
                        <Button Classes="small" Content="移除" Command="{Binding RemoveCommand}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <StackPanel Grid.Row="2" Spacing="3" Margin="0,10,0,0">
            <TextBlock Classes="label" Text="本机指纹（对方确认连接时，可以与他看到的指纹核对）" />
            <TextBlock Classes="mono" FontSize="12" Text="{Binding ThisDeviceFingerprint}" Foreground="{DynamicResource MutedBrush}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- 允许别人控制本机 -->
      <Border Grid.Column="2" Classes="card" DataContext="{Binding Host}" x:DataType="vm:HostViewModel">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="h2" Text="允许别人控制本机" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Name="StartHostingButton" Classes="accent" Content="开始" Command="{Binding StartCommand}" IsVisible="{Binding IsStopped}" />
                <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding IsStarting}" VerticalAlignment="Center" />
                <Button Name="StopHostingButton" Content="停止" Command="{Binding StopCommand}" IsVisible="{Binding IsHosting}" />
              </StackPanel>
            </Grid>
            <TextBlock Classes="muted" Text="{Binding StateText}" />

            <!-- Stopped: where to listen -->
            <StackPanel Spacing="6" IsVisible="{Binding !IsHosting}">
              <TextBlock Classes="label" Text="监听地址" Margin="0,6,0,0" />
              <TextBox Name="ListenBox" Text="{Binding ListenAddress}" IsEnabled="{Binding IsStopped}" />
              <TextBlock Classes="errorText" Text="{Binding ListenHint}" IsVisible="{Binding ListenHint, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <ItemsControl ItemsSource="{Binding AddressSuggestions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Button Classes="small" Margin="0,0,6,6" Content="{Binding}"
                            Command="{Binding $parent[ItemsControl].((vm:HostViewModel)DataContext).UseSuggestionCommand}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="muted" Text="请选择对方能访问到的地址：局域网、Tailscale，或只在本机测试时用 127.0.0.1。" />
            </StackPanel>

            <!-- Hosting: ID, address and code -->
            <StackPanel Spacing="4" IsVisible="{Binding IsHosting}">
              <TextBlock Classes="label" Text="本机 ID（对方用它连接）" Margin="0,6,0,0" IsVisible="{Binding HasDeviceId}" />
              <SelectableTextBlock Name="DeviceIdText" Text="{Binding DeviceIdDisplay}" FontFamily="{StaticResource MonoFont}"
                                   FontSize="28" FontWeight="Bold" LetterSpacing="2" IsVisible="{Binding HasDeviceId}" />
              <TextBlock Name="SignalStatusText" Classes="muted" TextWrapping="Wrap" Text="{Binding SignalText}"
                         IsVisible="{Binding !SignalProblem}" />
              <TextBlock Classes="errorText" TextWrapping="Wrap" Text="{Binding SignalText}" IsVisible="{Binding SignalProblem}" />
              <TextBlock Classes="errorText" TextWrapping="Wrap" IsVisible="{Binding RestartNeeded}"
                         Text="信令服务器设置已更改：停止后重新开始才会生效。" />
              <TextBlock Classes="label" Text="或在局域网 / Tailscale 内填写地址" Margin="0,6,0,0" />
              <SelectableTextBlock Name="ActiveListenText" Text="{Binding ActiveListen}" FontFamily="{StaticResource MonoFont}" FontSize="16" />
              <TextBlock Classes="label" Text="一次性码" Margin="0,10,0,0" />
              <Border Classes="subtle" Padding="16,10" HorizontalAlignment="Left">
                <SelectableTextBlock Name="CodeText" Text="{Binding CodeDisplay}" FontFamily="{StaticResource MonoFont}"
                                     FontSize="46" FontWeight="Bold" LetterSpacing="4" />
              </Border>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                <Button Name="RotateButton" Classes="small" Content="换一个代码" Command="{Binding RotateCodeCommand}" />
                <TextBlock Classes="muted" VerticalAlignment="Center" Text="每次有人连接，你都会看到确认窗口。" />
              </StackPanel>
              <Border Classes="warn" IsVisible="{Binding !InputAvailable}" Margin="0,6,0,0">
                <StackPanel Spacing="4">
                  <TextBlock Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap" FontSize="12.5"
                             Text="本机未授予“辅助功能”权限：对方只能查看，不能操作键盘鼠标。" />
                  <Button Classes="small" Content="查看如何授予…" Command="{Binding ShowPermissionGuideCommand}" />
                </StackPanel>
              </Border>
            </StackPanel>

            <Border Name="HostError" Classes="error" IsVisible="{Binding HasError}">
              <StackPanel Spacing="6">
                <TextBlock Classes="errorText" Text="{Binding Error}" />
                <Button Classes="small" Content="权限设置指引…" Command="{Binding ShowPermissionGuideCommand}" />
              </StackPanel>
            </Border>
            <TextBlock Classes="muted" Text="{Binding Notice}" IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0" IsVisible="{Binding IsHosting}">
              <TextBlock Classes="label" Text="已配对的设备" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="small" Content="刷新" Command="{Binding RefreshPairingsCommand}" />
            </Grid>
          </StackPanel>

          <ScrollViewer Grid.Row="1" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsHosting}">
            <ItemsControl Name="PairedList" ItemsSource="{Binding Paired}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PairedDeviceViewModel">
                  <Border Classes="subtle" Margin="0,0,0,6">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Classes="muted" Text="{Binding PermsText, StringFormat='权限：{0}'}" />
                        <TextBlock Classes="muted" Text="{Binding ConsentText}" />
                        <TextBlock Classes="muted" FontFamily="{StaticResource MonoFont}" Text="{Binding Fingerprint, StringFormat='指纹 {0}'}" />
                        <TextBlock Classes="muted" Text="{Binding LastSeen, StringFormat='上次连接：{0}'}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <Button Classes="small" Content="撤销配对" Command="{Binding RevokeCommand}" />
                        <Button Classes="small" Content="改为每次确认" Command="{Binding RequireConsentCommand}" IsVisible="{Binding Unattended}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
