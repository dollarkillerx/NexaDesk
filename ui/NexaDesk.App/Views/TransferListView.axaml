<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NexaDesk.ViewModels"
             xmlns:l="using:NexaDesk.Localization"
             x:Class="NexaDesk.Views.TransferListView"
             x:DataType="vm:TransferListViewModel">
  <!-- Files to and from the other side (§3.1 stream 4). Shared by the toolbar and the banner. -->
  <StackPanel Spacing="4">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Name="TransferSummary" Classes="label" Text="{Binding Summary}" VerticalAlignment="Center" />
      <Button Grid.Column="1" Classes="small" Content="{l:T Transfer.ClearFinished}" Command="{Binding ClearFinishedCommand}" />
    </Grid>
    <TextBlock Classes="errorText" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <ScrollViewer MaxHeight="196" VerticalScrollBarVisibility="Auto">
      <ItemsControl Name="TransferItems" ItemsSource="{Binding Items}" Margin="0,0,14,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TransferItemViewModel">
            <Grid ColumnDefinitions="56,*,Auto" Margin="0,3,0,3">
              <TextBlock Classes="label" Text="{Binding Direction}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="2">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Classes="label" Text="{Binding ProgressText}" Margin="10,0,0,0" />
                </Grid>
                <ProgressBar Value="{Binding Progress}" Maximum="100" MinHeight="4" Height="4" IsVisible="{Binding ShowProgress}" />
                <TextBlock Classes="muted" Classes.problem="{Binding IsProblem}" Classes.ok="{Binding IsDone}"
                           Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="10,0,0,0">
                <Button Classes="small accent" Content="{l:T Transfer.Accept}" Command="{Binding AcceptCommand}" IsVisible="{Binding NeedsAnswer}" />
                <Button Classes="small" Content="{l:T Transfer.Decline}" Command="{Binding DeclineCommand}" IsVisible="{Binding NeedsAnswer}" />
                <Button Classes="small" Content="{l:T Transfer.Cancel}" Command="{Binding CancelCommand}" IsVisible="{Binding ShowProgress}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </StackPanel>
</UserControl>
