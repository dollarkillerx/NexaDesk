<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NexaDesk.ViewModels"
        xmlns:l="using:NexaDesk.Localization"
        x:Class="NexaDesk.Views.ConsentDialog"
        x:DataType="vm:ConsentViewModel"
        Title="{l:T Consent.WindowTitle}"
        Width="540" SizeToContent="Height" CanResize="False"
        Topmost="True" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CardBrush}">
  <Grid RowDefinitions="Auto,Auto">
  <StackPanel Margin="16,16,16,20" Spacing="12">
    <TextBlock Classes="h1" Text="{Binding Headline}" TextWrapping="Wrap" />
    <TextBlock Classes="muted" FontSize="14" LetterSpacing="0.16"
               Text="{l:T Consent.Intro}" />
    <Border Name="BrowserNote" Classes="tint" IsVisible="{Binding IsBrowser}">
      <TextBlock TextWrapping="Wrap" Text="{l:T Consent.BrowserNote}" />
    </Border>

    <Border Classes="subtle">
      <Grid ColumnDefinitions="Auto,14,*" RowDefinitions="Auto,Auto,Auto,Auto" >
        <TextBlock Classes="label" Text="{l:T Consent.DeviceName}" />
        <TextBlock Grid.Column="2" Name="DeviceNameText" Text="{Binding DeviceName}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Grid.Row="1" Classes="label" Text="{l:T Consent.Auth}" Margin="0,4,0,0" />
        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding AuthText}" Margin="0,4,0,0" />
        <TextBlock Grid.Row="2" Classes="label" Text="{l:T Consent.Remote}" Margin="0,4,0,0" />
        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Remote}" Margin="0,4,0,0" />
        <TextBlock Grid.Row="3" Classes="label" Text="{l:T Consent.DeviceId}" Margin="0,4,0,0" IsVisible="{Binding IsDevice}" />
        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding DeviceId}" FontFamily="{DynamicResource MonoFont}" FontSize="12" Margin="0,4,0,0" IsVisible="{Binding IsDevice}" />
      </Grid>
    </Border>

    <StackPanel Spacing="4" IsVisible="{Binding IsDevice}">
      <TextBlock Classes="section" Text="{l:T Consent.FingerprintLabel}" />
      <Border Classes="subtle">
        <TextBlock Name="FingerprintText" Text="{Binding Fingerprint}" FontFamily="{DynamicResource MonoFont}" FontSize="14" />
      </Border>
    </StackPanel>

    <Border Classes="warn" IsVisible="{Binding IsTakeover}">
      <TextBlock TextWrapping="Wrap"
                 Text="{l:T Consent.Takeover}" />
    </Border>

    <StackPanel Spacing="2">
      <TextBlock Classes="section" Text="{l:T Consent.AllowThem}" Margin="0,0,0,2" />
      <CheckBox IsChecked="True" IsEnabled="False" Content="{l:T Consent.PermView}" />
      <CheckBox Name="InputBox" IsChecked="{Binding AllowInput}" IsEnabled="{Binding InputAvailable}" Content="{l:T Consent.PermInput}" />
      <TextBlock Classes="muted" Margin="28,-4,0,2" Text="{Binding InputNote}" />
      <CheckBox Name="ClipboardBox" IsChecked="{Binding AllowClipboard}" Content="{l:T Consent.PermClipboard}" IsVisible="{Binding IsDevice}" />
      <CheckBox Name="AudioBox" IsChecked="{Binding AllowAudio}" Content="{l:T Consent.PermAudio}" IsVisible="{Binding IsDevice}" />
      <CheckBox Name="FileBox" IsChecked="{Binding AllowFile}" Content="{l:T Consent.PermFile}" IsVisible="{Binding IsDevice}" />
      <TextBlock Classes="muted" Margin="28,-4,0,2" Text="{Binding FileNote}" TextWrapping="Wrap" IsVisible="{Binding IsDevice}" />
    </StackPanel>

    <StackPanel Spacing="2" IsVisible="{Binding OfferSave}">
      <CheckBox Name="SaveBox" IsChecked="{Binding SaveDevice}" Content="{l:T Consent.SaveDevice}" />
    </StackPanel>
    <StackPanel Spacing="2" IsVisible="{Binding OfferSkipNextTime}">
      <CheckBox Name="SkipBox" IsChecked="{Binding SkipNextTime}" Content="{l:T Consent.SkipNextTime}" />
      <TextBlock Classes="muted" Margin="28,-4,0,0"
                 Text="{l:T Consent.SkipNextTimeNote}" />
    </StackPanel>

    <TextBlock Classes="muted" Margin="0,4,0,0" Text="{Binding CountdownText}" />
  </StackPanel>

  <!-- Deny is the default and cancel button, and has focus: Enter, Space and Escape all deny. -->
  <Grid Grid.Row="1" ColumnDefinitions="*,1,*">
    <Button Name="AllowButton" Classes="footer" Content="{l:T Consent.Allow}"
            Command="{Binding AllowCommand}" />
    <Button Grid.Column="2" Name="DenyButton" Classes="accent footer" Content="{l:T Consent.Deny}"
            IsDefault="True" IsCancel="True" Command="{Binding DenyCommand}" />
  </Grid>
  </Grid>
</Window>
