<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NexaDesk.ViewModels"
        xmlns:l="using:NexaDesk.Localization"
        xmlns:views="using:NexaDesk.Views"
        x:Class="NexaDesk.Views.ControlBanner"
        x:DataType="vm:BannerViewModel"
        Title="{l:T Banner.WindowTitle}"
        Width="720" SizeToContent="Height" CanResize="False"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowDecorations="None" RequestedThemeVariant="Dark"
        Background="{DynamicResource BannerBrush}">
  <StackPanel>
    <!-- Orange 40 stripe and dot: the one loud colour on the banner. -->
    <Border Padding="16,0,8,0" Height="64" BorderBrush="#FF832B" BorderThickness="4,0,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
        <Ellipse Width="10" Height="10" Fill="#FF832B" VerticalAlignment="Center" Margin="0,0,14,0" />
        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
          <TextBlock Name="HeadlineText" Text="{Binding Headline}" Foreground="#F4F4F4" FontWeight="SemiBold" FontSize="14"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Foreground="#C6C6C6" FontSize="12" LetterSpacing="0.32" TextTrimming="CharacterEllipsis">
            <Run Text="{Binding PermsText}" />
            <Run Text=" · " />
            <Run Text="{Binding Detail}" />
          </TextBlock>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="#F4F4F4" FontFamily="{DynamicResource MonoFont}"
                   VerticalAlignment="Center" Margin="12,0,12,0" />
        <Button Grid.Column="3" Name="BannerDisconnectButton" Classes="danger wide" MinHeight="48" Content="{l:T Banner.Disconnect}" Command="{Binding DisconnectCommand}" />
      </Grid>
    </Border>
    <!-- Only with the file permission: drop files here to send them to the viewer (§3.1 stream 4). -->
    <Border Name="FilePanel" Background="{DynamicResource CardBrush}" Padding="16,10,16,12" IsVisible="{Binding CanSendFiles}">
      <StackPanel Spacing="6">
        <Border Name="DropZone" Classes="subtle" Padding="10,6">
          <TextBlock Name="DropHintText" Classes="muted" Text="{Binding DropHint}" HorizontalAlignment="Center" />
        </Border>
        <views:TransferListView DataContext="{Binding Transfers}" IsVisible="{Binding HasItems}" />
      </StackPanel>
    </Border>
  </StackPanel>
</Window>
