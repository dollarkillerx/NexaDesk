<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NexaDesk.ViewModels"
        xmlns:l="using:NexaDesk.Localization"
        xmlns:views="using:NexaDesk.Views"
        x:Class="NexaDesk.Views.ControlBanner"
        x:DataType="vm:BannerViewModel"
        Title="{l:T Banner.WindowTitle}"
        Width="720" SizeToContent="Height" CanResize="False"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowDecorations="None"
        Background="{DynamicResource BannerBrush}">
  <Window.Styles>
    <Style Selector="Button.onBanner">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#9A3412" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.onBanner:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FFF1E8" />
      <Setter Property="Foreground" Value="#9A3412" />
    </Style>
    <Style Selector="Button.onBanner:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FFE2D1" />
      <Setter Property="Foreground" Value="#9A3412" />
    </Style>
  </Window.Styles>
  <StackPanel>
    <Border Padding="18,0,12,0" Height="64">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
        <Ellipse Width="12" Height="12" Fill="White" VerticalAlignment="Center" Margin="0,0,12,0" />
        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
          <TextBlock Name="HeadlineText" Text="{Binding Headline}" Foreground="White" FontWeight="SemiBold" FontSize="14"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Foreground="White" Opacity="0.92" FontSize="12" TextTrimming="CharacterEllipsis">
            <Run Text="{Binding PermsText}" />
            <Run Text=" · " />
            <Run Text="{Binding Detail}" />
          </TextBlock>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="White" FontFamily="{DynamicResource MonoFont}"
                   VerticalAlignment="Center" Margin="12,0,12,0" />
        <Button Grid.Column="3" Name="BannerDisconnectButton" Classes="onBanner wide" Content="{l:T Banner.Disconnect}" Command="{Binding DisconnectCommand}" />
      </Grid>
    </Border>
    <!-- Only with the file permission: drop files here to send them to the viewer (§3.1 stream 4). -->
    <Border Name="FilePanel" Background="{DynamicResource CardBrush}" Padding="14,8,14,10" IsVisible="{Binding CanSendFiles}">
      <StackPanel Spacing="6">
        <Border Name="DropZone" Classes="subtle" Padding="10,6">
          <TextBlock Name="DropHintText" Classes="muted" Text="{Binding DropHint}" HorizontalAlignment="Center" />
        </Border>
        <views:TransferListView DataContext="{Binding Transfers}" IsVisible="{Binding HasItems}" />
      </StackPanel>
    </Border>
  </StackPanel>
</Window>
