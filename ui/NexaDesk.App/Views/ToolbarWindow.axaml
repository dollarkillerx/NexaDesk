<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NexaDesk.ViewModels"
        xmlns:views="using:NexaDesk.Views"
        x:Class="NexaDesk.Views.ToolbarWindow"
        x:DataType="vm:SessionViewModel"
        Title="NexaDesk 工具条"
        Width="940" SizeToContent="Height" CanResize="False"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowDecorations="None"
        Background="{DynamicResource ToolbarBrush}">
  <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="12,8">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="{Binding HostName}" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="160"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="label" Text="模式" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" Spacing="2">
            <RadioButton Name="ModeOffice" GroupName="mode" Content="办公" IsChecked="{Binding IsOffice}" />
            <RadioButton Name="ModeBalanced" GroupName="mode" Content="均衡" IsChecked="{Binding IsBalanced}" />
            <RadioButton Name="ModeGame" GroupName="mode" Content="游戏" IsChecked="{Binding IsGame}" />
          </StackPanel>
          <TextBlock Classes="label" Text="屏幕" VerticalAlignment="Center" IsVisible="{Binding HasManyDisplays}" />
          <ComboBox Name="DisplayPicker" ItemsSource="{Binding Displays}" SelectedItem="{Binding SelectedDisplay}"
                    IsVisible="{Binding HasManyDisplays}" MaxWidth="260" VerticalAlignment="Center">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DisplayChoice">
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Name="ResumeButton" Classes="small accent" Content="继续控制" Command="{Binding ResumeCommand}"
                  IsVisible="{Binding IsSuspended}" />
          <Button Name="MuteButton" Classes="small" Content="{Binding MuteLabel}" Command="{Binding ToggleMuteCommand}"
                  IsVisible="{Binding CanHearAudio}" />
          <Button Name="SendFilesButton" Classes="small" Content="发送文件…" Click="OnSendFiles"
                  IsVisible="{Binding CanSendFiles}" ToolTip.Tip="也可以把文件拖到会话窗口或工具条上" />
          <ToggleButton Name="HudButton" Classes="small" Content="HUD" IsChecked="{Binding IsHudVisible}"
                        Padding="10,3" FontSize="12.5" ToolTip.Tip="在画面上显示分段延迟、路径和帧率" />
          <Button Name="DiagnosticsButton" Classes="small" Content="诊断" Click="OnDiagnostics" />
          <Button Name="FullScreenButton" Classes="small" Content="全屏" Click="OnFullScreen" />
          <Button Name="HideButton" Classes="small" Content="隐藏" Command="{Binding ToggleToolbarCommand}" />
          <Button Name="ToolbarDisconnectButton" Classes="small" Content="断开" Command="{Binding DisconnectCommand}"
                  Foreground="{DynamicResource ErrorBrush}" />
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,6,0,0">
        <TextBlock Name="CaptureText" Classes="muted" Text="{Binding CaptureText}" TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap" IsVisible="{Binding !IsReconnecting}" />
        <TextBlock Name="ReconnectText" Text="{Binding ReconnectText}" Foreground="{DynamicResource WarnBrush}"
                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                   IsVisible="{Binding IsReconnecting}" />
        <TextBlock Grid.Column="1" Name="AudioText" Classes="muted" Text="{Binding AudioText}" Margin="16,0,0,0"
                   TextWrapping="NoWrap" IsVisible="{Binding CanHearAudio}" />
        <TextBlock Grid.Column="2" Name="ClipboardText" Classes="muted" Text="{Binding ClipboardText}" Margin="16,0,0,0"
                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="320" />
      </Grid>
      <TextBlock Grid.Row="2" Name="WarningText" Text="{Binding Warning}" Foreground="{DynamicResource WarnBrush}"
                 TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0" IsVisible="{Binding HasWarning}" />
      <Border Grid.Row="3" Name="TransferPanel" Classes="subtle" Margin="0,8,0,0" IsVisible="{Binding Transfers.HasItems}">
        <views:TransferListView DataContext="{Binding Transfers}" />
      </Border>
    </Grid>
  </Border>
</Window>
