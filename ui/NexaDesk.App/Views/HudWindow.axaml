<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NexaDesk.ViewModels"
        xmlns:l="using:NexaDesk.Localization"
        x:Class="NexaDesk.Views.HudWindow"
        x:DataType="vm:HudViewModel"
        Title="NexaDesk HUD"
        Width="290" SizeToContent="Height" CanResize="False"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        WindowDecorations="None" IsHitTestVisible="False"
        Background="#E6111318">
  <!-- §10.3: an owned, borderless, click-through window over the native video. Always dark. -->
  <StackPanel Margin="12,10,12,10" Spacing="3">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Text="{l:T Hud.Header}" Foreground="#E5E7EB" FontWeight="SemiBold" FontSize="12" />
      <TextBlock Grid.Column="1" Name="HudFps" Text="{Binding FpsText}" Foreground="#86EFAC" FontFamily="{DynamicResource MonoFont}" FontSize="12" />
    </Grid>
    <ItemsControl Name="HudSegments" ItemsSource="{Binding Segments}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:HudSegment">
          <Grid ColumnDefinitions="*,Auto" Margin="0,1">
            <TextBlock Text="{Binding Label}" Foreground="#A3AAB6" FontSize="12" />
            <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#F3F4F6" FontFamily="{DynamicResource MonoFont}" FontSize="12" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Name="HudPath" Text="{Binding PathText}" Foreground="#E5E7EB" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
    <TextBlock Text="{Binding Note}" Foreground="#8B93A1" FontSize="11" TextWrapping="Wrap" />
  </StackPanel>
</Window>
