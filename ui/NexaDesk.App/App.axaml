<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NexaDesk.App"
             Name="NexaDesk"
             RequestedThemeVariant="Default">
  <!--
    Arc's visual language (TKCode.Arc, https://github.com/AIDotNet/TKCode.Arc, after uiarc.dev):
    white and near-black surfaces with hairline borders and soft shadows, rounded cards, pill
    buttons, Inter for Latin text (the system CJK fonts for Han and kana), Lucide line icons, and one
    accent (Arc's blue) for anything interactive. Five button kinds: primary ("accent", Fluent's own
    class), secondary (the default), tertiary, ghost and danger.

    The colours come from Arc's palette in ArcLook.cs, as our own brushes (PageBrush, CardBrush...)
    and the Fluent keys its controls read (ButtonBackground...), so every control agrees. The shapes,
    sizes and type are here.
  -->
  <Application.Resources>
    <ResourceDictionary>
      <!-- The colours, light and dark, are Arc's palette, filled in by ArcLook.cs at start-up. -->
      <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
      <!-- Replaced per language at start-up (App.UseFontsFor). -->
      <FontFamily x:Key="UiFont">fonts:Inter#Inter, Helvetica Neue, PingFang SC, Hiragino Sans GB, sans-serif</FontFamily>
      <FontFamily x:Key="MonoFont">SF Mono, Menlo, PingFang SC, monospace</FontFamily>
      <!-- Arc's elevations: resting under cards, raised under what floats. -->
      <BoxShadows x:Key="ShadowResting">0 1 2 0 #0A000000</BoxShadows>
      <BoxShadows x:Key="ShadowRaised">0 6 18 0 #11000000, 0 1 3 0 #09000000</BoxShadows>

      <!-- The icons (IconMonitor...) are Arc's Lucide glyphs, put here by ArcLook.cs. -->
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <!-- Progress bars, focus and selection take the accent from here; ArcLook sets it to Arc's. -->
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#FF0562EF" />
        <ColorPaletteResources x:Key="Dark" Accent="#FF6BA3FF" />
      </FluentTheme.Palettes>
    </FluentTheme>

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Background" Value="{DynamicResource PageBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <!-- Surfaces: a hairline, rounded corners, a resting shadow. -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="BoxShadow" Value="{DynamicResource ShadowResting}" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Border.subtle">
      <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="16,12" />
    </Style>
    <!-- Inline notifications: a tinted, rounded panel with a hairline in its colour; primary text. -->
    <Style Selector="Border.error, Border.warn, Border.ok, Border.tint">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14,12,16,12" />
    </Style>
    <Style Selector="Border.error">
      <Setter Property="Background" Value="{DynamicResource ErrorBackBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ErrorEdgeBrush}" />
    </Style>
    <Style Selector="Border.warn">
      <Setter Property="Background" Value="{DynamicResource WarnBackBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource WarnEdgeBrush}" />
    </Style>
    <Style Selector="Border.ok">
      <Setter Property="Background" Value="{DynamicResource OkBackBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OkEdgeBrush}" />
    </Style>
    <Style Selector="Border.tint">
      <Setter Property="Background" Value="{DynamicResource InfoBackBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InfoEdgeBrush}" />
    </Style>
    <!-- A row of a list: its own rounded tile with a hairline, a fill under the pointer. -->
    <Style Selector="Border.item">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="14,12" />
    </Style>
    <Style Selector="Border.item:pointerover">
      <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
    </Style>
    <!-- Tags: an accent-tinted pill. -->
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="{DynamicResource BadgeBrush}" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="8,1,8,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge > TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource BadgeTextBrush}" />
    </Style>
    <Style Selector="Border.pill">
      <Setter Property="Padding" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- A page's own icon sits on a soft rounded tile; small ones in lists stand alone. -->
    <Style Selector="Border.iconTile">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.iconTile > Path.icon">
      <Setter Property="Stroke" Value="{DynamicResource AccentStrongBrush}" />
    </Style>
    <Style Selector="Border.iconTile.small">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
    </Style>
    <Style Selector="Path.icon">
      <Setter Property="Stroke" Value="{DynamicResource TextBrush}" />
      <Setter Property="StrokeThickness" Value="1.75" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.iconTile.small > Path.icon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Stroke" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="Path.icon.muted">
      <Setter Property="Stroke" Value="{DynamicResource MutedBrush}" />
    </Style>

    <!-- Type: semibold, slightly tight headings; quiet secondary text. -->
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="-0.2" />
      <Setter Property="LineHeight" Value="30" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="21" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="-0.2" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.muted.problem">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="TextBlock.muted.ok">
      <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
    </Style>
    <Style Selector="TextBlock.errorTitle">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.errorText">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- Inside a notification the panel carries the colour; the text stays primary. -->
    <Style Selector="Border.error TextBlock.errorTitle, Border.error TextBlock.errorText">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    </Style>
    <Style Selector="TextBlock.itemTitle">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Fields: white with a hairline all round, rounded; the accent when focused. -->
    <Style Selector="TextBox, ComboBox">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="MinHeight" Value="40" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Padding" Value="14,0,8,0" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="Expander">
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="CornerRadius" Value="999" />
    </Style>
    <Style Selector="ToolTip">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!--
      Buttons are pills, 40 px tall (or 32 px with "small"), the label centred, medium weight.
    -->
    <Style Selector="Button, ToggleButton.small">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="20,0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.small, ToggleButton.small">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.wide">
      <Setter Property="MinWidth" Value="144" />
    </Style>
    <!-- Tertiary: outlined in the accent, a tint on hover. "onTint" is the old name. -->
    <Style Selector="Button.tertiary, Button.onTint">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.tertiary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.onTint:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentStrongBrush}" />
    </Style>
    <Style Selector="Button.tertiary:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.onTint:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentStrongBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <!-- Ghost: text in the accent, a grey fill on hover. -->
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
    </Style>
    <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtlePressedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
    </Style>
    <!-- Quiet: toolbar actions, no fill and primary text, grey under the pointer. -->
    <Style Selector="Button.quiet">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.quiet:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtlePressedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <!-- Link: opens a web page (GitHub, the website); text in the accent, no frame. -->
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AccentStrongBrush}" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
    </Style>
    <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtlePressedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
    </Style>
    <!-- Danger: ends something (stop, disconnect, revoke). -->
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
    </Style>
    <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DangerPressedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
    </Style>
    <!-- Copy: a value that copies itself when clicked; a grey fill under the pointer. -->
    <Style Selector="Button.copy">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.copy:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.copy:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtlePressedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.copy TextBlock.big">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="FontSize" Value="38" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="LetterSpacing" Value="3" />
    </Style>
    <Style Selector="Button.copy TextBlock.copyHint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.copy:pointerover TextBlock.copyHint">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.copy TextBlock.copied">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
    </Style>
    <!-- The same as icons, where a word would take width from the value (an address row). -->
    <Style Selector="Button.copy Path.icon.copyHint">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Stroke" Value="{DynamicResource MutedBrush}" />
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.copy:pointerover Path.icon.copyHint">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.copy Path.icon.copied">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="Stroke" Value="{DynamicResource OkBrush}" />
    </Style>
    <!-- Shell header actions: full height, secondary text, a fill under the pointer. -->
    <Style Selector="Button.shell">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Button.shell:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.shell:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtlePressedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <!-- Main window: a soft grey sidebar of rounded rows, the page on white beside it. -->
    <Style Selector="Border.sidebar">
      <Setter Property="Background" Value="{DynamicResource PageBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style Selector="Border.page">
      <Setter Property="Padding" Value="36,28,36,36" />
      <Setter Property="MaxWidth" Value="800" />
      <!-- Every page as wide as the window allows up to that, centred beyond it. -->
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="10,0" />
      <Setter Property="Padding" Value="11,8,12,8" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.nav:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SubtlePressedBrush}" />
    </Style>
    <Style Selector="Button.nav.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NavSelectedBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.nav.selected">
      <Setter Property="Effect">
        <DropShadowEffect OffsetX="0" OffsetY="1" BlurRadius="3" Opacity="0.06" Color="Black" />
      </Setter>
    </Style>
    <Style Selector="Button.nav Path.navIcon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Stroke" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="Button.nav.selected Path.navIcon">
      <Setter Property="Stroke" Value="{DynamicResource AccentStrongBrush}" />
    </Style>
    <Style Selector="Button.nav:pointerover Path.navIcon">
      <Setter Property="Stroke" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="TextBlock.settingsHeading">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Border.settingsGroup">
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="20,18" />
    </Style>
    <!-- Dialog footer: two pill buttons side by side along the bottom. -->
    <Style Selector="Button.footer">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="20,8,6,20" />
    </Style>
    <Style Selector="Button.footer:nth-last-child(1)">
      <Setter Property="Margin" Value="6,8,20,20" />
    </Style>

    <!-- Content switcher: radio buttons in a Border.segments track; the chosen one is a raised chip. -->
    <Style Selector="Border.segments">
      <Setter Property="Background" Value="{DynamicResource SegmentTrackBrush}" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="RadioButton.segment">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="SegmentBack" Background="{TemplateBinding Background}" MinHeight="26" Padding="14,0" CornerRadius="999">
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.segment:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="RadioButton.segment:checked">
      <Setter Property="Background" Value="{DynamicResource SegmentOnBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="RadioButton.segment:checked /template/ Border#SegmentBack">
      <Setter Property="BoxShadow" Value="{DynamicResource ShadowResting}" />
    </Style>
  </Application.Styles>
</Application>
