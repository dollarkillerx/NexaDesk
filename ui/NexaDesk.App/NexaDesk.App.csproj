<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>NexaDesk</RootNamespace>
    <AssemblyName>NexaDesk</AssemblyName>
    <Version>0.1.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- NativeAOT (§10.4): no reflection-based binding, JSON or marshalling anywhere. -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimMode>full</TrimMode>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS8500;CS8981</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The C ABI, generated by csbindgen from crates/nexa-client/src/abi.rs. -->
    <Compile Include="../../crates/nexa-client/bindings/*.cs" Link="Native/Bindings/%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="NexaDesk.Tests" />
  </ItemGroup>

  <!-- For `dotnet run`: the library built by cargo next to the app. The bundle script copies it itself. -->
  <ItemGroup Condition="Exists('../../target/release/libnexa_client.dylib')">
    <None Include="../../target/release/libnexa_client.dylib" Link="libnexa_client.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
