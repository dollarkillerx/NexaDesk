<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>NexaDesk</RootNamespace>
    <AssemblyName>NexaDesk</AssemblyName>
    <Version>0.1.22</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- NativeAOT (§10.4): no reflection-based binding, JSON or marshalling anywhere. -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimMode>full</TrimMode>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS8500;CS8981</NoWarn>
    <!-- Windows: declares Windows 10/11, without which the session's video view cannot be made. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- The Windows installer and its hooks (scripts/package-windows.sh); a no-op elsewhere. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <!-- The icon of NexaDesk.exe on Windows (Explorer, the taskbar, the Start menu). -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI text (Localization/L.cs): i18n/<language>/<area>.json inside the assembly. -->
    <EmbeddedResource Include="Localization/Strings/**/*.json" LogicalName="i18n/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The C ABI, generated by csbindgen from crates/nexa-client/src/abi.rs. -->
    <Compile Include="../../crates/nexa-client/bindings/*.cs" Link="Native/Bindings/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The terminal control from MySSH, for the host's command line. -->
    <ProjectReference Include="../NexaDesk.Terminal/NexaDesk.Terminal.csproj" />
    <InternalsVisibleTo Include="NexaDesk.Tests" />
  </ItemGroup>

  <!-- For `dotnet run`: the library built by cargo next to the app. The bundle script copies it itself. -->
  <ItemGroup Condition="Exists('../../target/release/libnexa_client.dylib') And !$(RuntimeIdentifier.StartsWith('win'))">
    <None Include="../../target/release/libnexa_client.dylib" Link="libnexa_client.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
